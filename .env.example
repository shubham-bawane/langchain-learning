# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Choose one of these LLM providers:

# Option 1: OpenAI (GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: OpenRouter (Cost-optimized, supports multiple models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Website Studio: max output tokens per LLM call (default 8192). Lowered automatically
# if the provider says the account can't afford that many; set lower to cap spend.
# STUDIO_MAX_TOKENS=8192

# Option 3: Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# LANGSMITH TRACING (Optional - monitor every graph node, LLM call, tokens and QA scores)
# =============================================================================
# Tracing turns on automatically when LANGSMITH_API_KEY is set; use LANGSMITH_TRACING=false to opt out.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=langchain-learning

# =============================================================================
# QDRANT VECTOR DATABASE (Optional - for metadata storage and retrieval)
# =============================================================================
# Leave empty if not using Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=langchain-learning

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Allow execution of LLM-generated code (use with caution)
FLOW_ALLOW_CODE_EXEC=false

