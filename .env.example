OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-learning
# Qdrant vector DB for RAG (put real values in .env, not here)
QDRANT_URL=
QDRANT_API_KEY=


QDRANT_COLLECTION=langchain-learning

# Opt in to running LLM-written code (sandboxed). Leave false unless you need Flow engineering mode.
FLOW_ALLOW_CODE_EXEC=false
